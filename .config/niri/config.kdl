// niri 26.04

// TODO:
// Waybar failed-unit diagnostics and click action
// hibernation for preserving the session across shutdown
// rebind fullscreen-window, deferred when Super+Space became the overview
// rebind consume-or-expel-window-left/right, dropped when Super+Comma and Super+Period became workspace focus
// recent-windows switcher, unmasked by freeing Super+Tab; defaults are Super+Tab and Super+grave, tune with a recent-windows section

// TODO (unimplemented):
// fill empty space after shrinking/closing columns: https://github.com/niri-wm/niri/pull/4400
// toggle overview by tapping Super alone: https://github.com/niri-wm/niri/pull/3621 (builds on #2456)
// partial zoom-out for context while moving windows: https://github.com/niri-wm/niri/pull/3194 (zoom presets and overview-zoom-in/out actions)
// animate workspace moves and dis/appearance in the overview: https://github.com/niri-wm/niri/issues/1469 (open issue, no PR; every structural workspace action clears workspace-switch in src/layout/monitor.rs)
// window names under windows in the overview: no upstream issue or PR; the recent-windows switcher already draws titles under previews (src/ui/mru.rs)

// session startup and listeners
spawn-sh-at-startup "exec \"${HOME}/.config/niri/scripts/startup.sh\""
spawn-sh-at-startup "exec \"${HOME}/.config/niri/scripts/bitwarden-popups.py\""
spawn-sh-at-startup "exec \"${HOME}/.config/niri/scripts/workspaces.py\" watch"

// screenshots
screenshot-path "~/pics/screenshots/suzuki/%m-%d-%y_%H-%M-%S.png"

// input
input {
    focus-follows-mouse
    keyboard {
        xkb { layout "us"; }
        repeat-delay 200
    }
    touchpad {
        natural-scroll
    }
}

// display
output "eDP-1" {
    mode "2880x1920@120"
    scale 2
}

// layout and appearance
layout {
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    focus-ring { off; }
    border {
        on
        width 3
        active-color "#363840"
        inactive-color "#14161c"
        urgent-color "#5b9bf8"
    }
    gaps 8
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }

// overview
overview {
    backdrop-color "#14161c"
}

// animations
animations {
    workspace-switch         { spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001; }
    window-movement          { spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001; }
    window-resize            { spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001; }
    overview-open-close      { spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001; }
    window-open              { duration-ms 100; curve "ease-out-quad"; }
    window-close             { duration-ms 100; curve "ease-out-quad"; }
}

// window rules
window-rule {
    match app-id="^firefox$"
    match app-id="^code$"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="^firefox$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id=r#"^com\.waybar\.popup$"#
    open-floating true
    default-column-width  { fixed 800; }
    default-window-height { fixed 500; }
}

// keybindings
binds {

    // workspace focus
    Super+Q   { focus-workspace 1; }
    Super+W   { focus-workspace 2; }
    Super+E   { focus-workspace 3; }
    Super+A   { focus-workspace 4; }
    Super+S   { focus-workspace 5; }
    Super+D   { focus-workspace 6; }
    Super+Z   { focus-workspace 7; }
    Super+X   { focus-workspace 8; }
    Super+C   { focus-workspace 9; }
    // index 255 selects the bottom empty workspace
    Super+V   { focus-workspace 255; }
    Super+F   { focus-workspace-previous; }

    // send windows to workspaces
    Super+Ctrl+Q { move-window-to-workspace 1 focus=false; }
    Super+Ctrl+W { move-window-to-workspace 2 focus=false; }
    Super+Ctrl+E { move-window-to-workspace 3 focus=false; }
    Super+Ctrl+A { move-window-to-workspace 4 focus=false; }
    Super+Ctrl+S { move-window-to-workspace 5 focus=false; }
    Super+Ctrl+D { move-window-to-workspace 6 focus=false; }
    Super+Ctrl+Z { move-window-to-workspace 7 focus=false; }
    Super+Ctrl+X { move-window-to-workspace 8 focus=false; }
    Super+Ctrl+C { move-window-to-workspace 9 focus=false; }
    Super+Ctrl+V { move-window-to-workspace 255 focus=false; }

    // focus and move windows
    Super+J              { focus-column-left; }
    Super+K              { focus-window-or-workspace-down; }
    Super+L              { focus-window-or-workspace-up; }
    Super+Semicolon      { focus-column-right; }
    Super+Ctrl+J         { move-column-left; }
    Super+Ctrl+K         { move-window-down-or-to-workspace-down; }
    Super+Ctrl+L         { move-window-up-or-to-workspace-up; }
    Super+Ctrl+Semicolon { move-column-right; }

    // focus and move workspaces
    Super+M           { focus-monitor-left; }
    Super+Comma       { focus-workspace-down; }
    Super+Period      { focus-workspace-up; }
    Super+Slash       { focus-monitor-right; }
    Super+Ctrl+M      { move-workspace-to-monitor-left; }
    Super+Ctrl+Comma  { move-workspace-down; }
    Super+Ctrl+Period { move-workspace-up; }
    Super+Ctrl+Slash  { move-workspace-to-monitor-right; }

    // change window and column sizing
    Super+U      { set-column-width "50%"; }
    Super+I      { set-window-height "50%"; }
    Super+O      { set-window-height "100%"; }
    Super+P      { set-column-width "100%"; }
    Super+Ctrl+U { set-column-width "-12.5%"; }
    Super+Ctrl+I { set-window-height "-25%"; }
    Super+Ctrl+O { set-window-height "+25%"; }
    Super+Ctrl+P { set-column-width "+12.5%"; }

    // border keys
    Super+BackSpace      repeat=false { spawn "swaylock"; }
    Super+Ctrl+BackSpace repeat=false { close-window; }
    Super+Space          repeat=false { toggle-overview; }
    Super+Return         repeat=false { spawn-sh "exec \"${HOME}/.config/niri/scripts/workspaces.py\" rename"; }
    Super+Escape         repeat=false { spawn "fuzzel"; }

    // launch applications
    Super+Y      repeat=false { spawn "spotify-launcher"; }
    Super+G      repeat=false { spawn "firefox" "--new-window"; }
    Super+Ctrl+G repeat=false { spawn "firefox" "--new-window" "--private-window"; }
    Super+B      repeat=false { spawn "ghostty"; }
    Super+Ctrl+B repeat=false { spawn "ghostty" "+new-window" "-e" "bash" "-c" "cd ~/.hosts/${HOSTNAME} && exec claude"; }
    Super+H      repeat=false { spawn "thunar"; }
    Super+N      repeat=false { spawn "code" "--enable-features=UseOzonePlatform" "--ozone-platform=wayland"; }
    Super+Ctrl+N repeat=false { spawn "code" "--new-window" "--enable-features=UseOzonePlatform" "--ozone-platform=wayland"; }

    // screenshots
    Print       repeat=false { screenshot show-pointer=false; }
    Shift+Print repeat=false { screenshot-window show-pointer=false; }

    // brightness
    XF86MonBrightnessUp   { spawn "brightnessctl" "--exponent=2.5" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "--exponent=2.5" "set" "10%-"; }

    // playback
    XF86AudioPlay    repeat=false allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause   repeat=false allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop    repeat=false allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioNext    repeat=false                        { spawn "playerctl" "next"; }
    XF86AudioPrev    repeat=false                        { spawn "playerctl" "previous"; }
    XF86AudioForward                                     { spawn "playerctl" "position" "+10"; }
    XF86AudioRewind                                      { spawn "playerctl" "position" "-10"; }

    // volume
    XF86AudioMute        repeat=false { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioLowerVolume              { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioRaiseVolume              { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
}
