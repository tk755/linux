{
    "layer": "top",
    "position": "top",
    "margin-left": 8,
    "margin-right": 8,
    "height": 27,
    "margin-top": 6,
    "reload_style_on_change": true,

    "modules-left": [
        "group/arch-group",
        "group/battery-group",
        "group/disk-group",
        "group/memory-group",
        "group/cpu-group",
        // "custom/claude"
        "systemd-failed-units"
    ],
    "modules-center": [
        "custom/workspace"
    ],
    "modules-right": [
        "backlight",
        "pulseaudio",
        "group/bluetooth-group",
        "group/network-group",
        "group/clock-group"
    ],

    "group/arch-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/arch-icon",
            "custom/arch-updates"
        ]
    },

    "custom/arch-icon": {
        "format": "",
        "return-type": "json",
        "signal": 2,
        "exec": "~/.config/waybar/scripts/arch-updates.sh cache",
        "on-click": "ghostty --class=com.waybar.popup --wait-after-command -e ~/.hosts/suzuki/upgrade",
        "tooltip": false
    },

    "custom/arch-updates": {
        "format": "{}",
        "return-type": "json",
        "interval": 600,
        "signal": 1,
        "exec": "~/.config/waybar/scripts/arch-updates.sh",
        "on-click": "pkill -SIGRTMIN+1 waybar",
        "tooltip": true
    },

    "group/disk-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "disk#main",
            "custom/disk-usage"
        ]
    },

    "disk#main": {
        "interval": 30,
        "format": " {percentage_used}%",
        "path": "/",
        "tooltip": false
    },

    "custom/disk-usage": {
        "interval": 30,
        "exec": "~/.config/waybar/scripts/disk-usage.sh",
        "tooltip": false
    },

    "group/memory-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "memory#main",
            "memory#usage"
        ]
    },

    "memory#main": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip": false
    },

    "memory#usage": {
        "interval": 5,
        "format": "{used:0.0f} GiB / {total:0.0f} GiB",
        "tooltip": false
    },

    "group/cpu-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "cpu",
            "temperature"
        ]
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": false
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "warning-threshold": 85,
        "critical-threshold": 95,
        "format": "{temperatureC}°C",
        "tooltip": false
    },

    "custom/workspace": {
        "return-type": "json",
        "exec": "~/.config/niri/scripts/workspaces.py label",
        "exec-on-event": false,
        "escape": true,
        "tooltip": false,
        "on-click": "\"${HOME}/.config/niri/scripts/workspaces.py\" rename"
    },

    "group/clock-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "clock#main",
            "clock#date"
        ]
    },

    "clock#main": {
        "interval": 60,
        "format": "{:%I:%M %p}",
        "tooltip": false
    },

    "clock#date": {
        "interval": 60,
        "format": "{:%a, %b %d}",
        "tooltip": false
    },

    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "interval": 900,
        "exec": "~/.config/waybar/scripts/weather.sh",
        "tooltip": false
    },

    "custom/claude": {
        "format": "{}",
        "return-type": "json",
        "interval": 300,
        "exec": "~/.config/waybar/scripts/claude.sh",
        "tooltip": false
    },

    "systemd-failed-units": {
        "format": "󰗖 {nr_failed} failed",
        "hide-on-ok": true,
        "system": true,
        "user": true
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted 󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%-",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+",
        "tooltip": false
    },

    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 1%-",
        "on-scroll-down": "brightnessctl set +1%",
        "tooltip": false
    },

    "group/bluetooth-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/bluetooth",
            "custom/bluetooth-detail"
        ]
    },

    "custom/bluetooth": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/waybar/scripts/bluetooth.sh",
        "on-click": "ghostty --class=com.waybar.popup -e bluetui",
        "tooltip": false
    },

    "custom/bluetooth-detail": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/waybar/scripts/bluetooth.sh detail",
        "tooltip": true
    },

    "group/network-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "network#main",
            "network#ip"
        ]
    },

    "network#main": {
        "interval": 5,
        "format-wifi": "{essid} {icon}",
        "format-ethernet": "{ipaddr}/{cidr} {icon}",
        "format-disconnected": "disconnected 󰤭",
        "format-disabled": "disabled 󰤮",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": ["󰈀"]
        },
        "on-click": "ghostty --class=com.waybar.popup -e nmtui",
        "tooltip": false
    },

    "network#ip": {
        "interval": 5,
        "format-wifi": "{ipaddr}",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip": false
    },

    "group/battery-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "battery#main",
            "battery#detail"
        ]
    },

    "battery#main": {
        "interval": 30,
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "states": {
            "warning": 30,
            "low": 20,
            "critical": 10
        },
        "tooltip": false
    },

    "battery#detail": {
        "interval": 30,
        "format": "{time}",
        "format-full": "",
        "states": {
            "warning": 30,
            "low": 20,
            "critical": 10
        },
        "tooltip": false
    }
}
