#!/usr/bin/env bash

set -euo pipefail

REPO_URL_HTTPS="https://github.com/tk755/machines.git"
REPO_LOCAL_DIR="$HOME/.machines.git"
BACKUP_DIR="$HOME/.bootstrap-backup"

# paths to exclude in headless install
HEADLESS_EXCLUDES=(
    ".config/gtk-3.0"
    ".config/i3"
    ".config/niri"
    ".config/sway"
    ".fonts"
    ".icons"
    ".themes"
    ".wallpapers"
    ".Xresources"
)

# default flags
HEADLESS=false
FORCE=false

# auto-detect headless environment (WSL or no DISPLAY)
if grep -qi microsoft /proc/version 2>/dev/null; then
    HEADLESS=true
elif [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    HEADLESS=true
fi

# global variables
PROCESS_ICON="\e[36m⮞\e[0m"
FINISH_ICON="\e[32m✓\e[0m"

print_help() {
    cat <<EOF
Usage: bootstrap [OPTIONS]

Options:
    --all           Check out all files (override headless detection)
    --force         Overwrite local conflicts (destructive)
    --help          Show this help message

Headless exclude patterns:
    ${HEADLESS_EXCLUDES[*]}

Description:
    Installs the latest version of $REPO_URL_HTTPS.
      - Clones the bare repository to $REPO_LOCAL_DIR.
      - Removes the previous repo and its tracked files.

    Uses sparse checkout to exclude GUI-related files in headless environments.
      - Auto-detected on WSL and when DISPLAY is not set.
      - Use --all to override and check out all files.

    Conflicting files are backed up to $BACKUP_DIR.
      - By default, these files are restored automatically.
      - Use --force to skip the restore step.
EOF
}

parse_args() {
    for arg in "$@"; do
        case "$arg" in
            --all)      HEADLESS=false              ;;
            --force)    FORCE=true                  ;;
            --help)     print_help && exit 0        ;;
            *) echo "Invalid arg: $arg" && exit 1   ;;
        esac
    done
}

print_bold() {
    printf "\e[1m%s\e[0m\n" "$1"
}

# bare repository git wrapper function
repo() {
    git --git-dir="$REPO_LOCAL_DIR" --work-tree="$HOME" "$@"
}

backup_local_changes() {
    # the tree the checkout will install; HEAD is correct for a fresh clone
    local incoming="${1:-HEAD}"

    # if local history is not already contained upstream, a path missing from
    # the incoming tree is local work rather than an upstream deletion
    local keep_missing=false
    if ! repo merge-base --is-ancestor HEAD "$incoming"; then
        keep_missing=true
    fi

    echo -e " $PROCESS_ICON Backing up local changes"

    if [ -d "$BACKUP_DIR" ]; then
        rm -rf "$BACKUP_DIR"
    fi

    # iterate through all file paths tracked in HEAD
    while IFS= read -r file; do
        local full_path="$HOME/$file"

        # skip if not a regular file
        if [ ! -f "$full_path" ]; then
            continue
        fi

        # skip if image extension
        case "${file##*.}" in
            png|jpg|jpeg|gif|bmp|svg|ico|tiff|webp) continue ;;
        esac

        # save local edits, and files the incoming tree will not restore
        if ! diff -q "$full_path" <(repo show HEAD:"$file" 2>/dev/null) &>/dev/null ||
           { [ "$keep_missing" = true ] &&
             ! repo cat-file -e "$incoming:$file" 2>/dev/null; }; then
            local backup_path="$BACKUP_DIR/$file"
            mkdir -p "$(dirname "$backup_path")"
            cp "$full_path" "$backup_path"
        fi
    done < <({ repo ls-tree -r --name-only HEAD
               repo ls-tree -r --name-only "$incoming"; } | sort -u)
}

restore_local_changes() {
    if [ "$FORCE" = true ] || [ ! -d "$BACKUP_DIR" ]; then
        return
    fi

    echo -e " $PROCESS_ICON Restoring local changes"

    # restore files from backup directory
    find "$BACKUP_DIR" -type f | while IFS= read -r backup_file; do
        rel_path="${backup_file#$BACKUP_DIR/}"
        dest_path="$HOME/$rel_path"
        mkdir -p "$(dirname "$dest_path")"
        cp "$backup_file" "$dest_path"
    done
}

print_local_changes() {
    if [ ! -d "$BACKUP_DIR" ]; then
        return
    fi

    echo
    if [ "$FORCE" = true ]; then
        echo "Local changes overwritten (backup in $BACKUP_DIR):"
        local color="\e[31m"
    else
        echo "Local changes preserved (overwrite with --force):"
        local color="\e[33m"
    fi

    local reset_color="\e[0m"
    while IFS= read -r file; do
        path="${file#$BACKUP_DIR/}"
        printf " ${color}%s${reset_color} %s\n" "M" "$path"
    done < <(find "$BACKUP_DIR" -type f | sort)
}

fetch_remote() {
    echo -e " $PROCESS_ICON Fetching from \e[94m$REPO_URL_HTTPS\e[0m"

    # clone via HTTPS to avoid needing SSH keys
    repo fetch --quiet "$REPO_URL_HTTPS" main
}

clone_repo() {
    echo -e " $PROCESS_ICON Cloning from \e[94m$REPO_URL_HTTPS\e[0m"

    # clone via HTTPS to avoid needing SSH keys
    git clone --bare --branch main "$REPO_URL_HTTPS" "$REPO_LOCAL_DIR" &> /dev/null

    # change url to SSH for future pushes
    REPO_URL_SSH="git@github.com:${REPO_URL_HTTPS#https://github.com/}"
    git --git-dir="$REPO_LOCAL_DIR" remote set-url origin "$REPO_URL_SSH"

    # configure git settings
    repo config branch.main.remote origin
    repo config branch.main.merge refs/heads/main
    repo config --local status.showUntrackedFiles no
    repo config core.sparseCheckout true
}

delete_repo() {
    echo -e " $PROCESS_ICON Deleting repo and tracked files"

    # delete all tracked files
    repo ls-tree -r --name-only HEAD |
        sed "s|^|$HOME/|" |
        xargs -r -d '\n' rm -f

    # delete all tracked directories that are now empty
    repo ls-tree -r --name-only HEAD |
        awk -F/ 'NF>1 { $NF=""; print $0 }' OFS="/" |
        sed 's:/$::' |
        sort -u |
        sed "s|^|$HOME/|" |
        xargs -r -d '\n' rmdir 2>/dev/null || true

    # delete repo
    rm -rf "$REPO_LOCAL_DIR"
}

sparse_checkout() {
    echo -e " $PROCESS_ICON Checking out files"

    # create sparse checkout file
    local sparse_file="$REPO_LOCAL_DIR/info/sparse-checkout"
    mkdir -p "$(dirname "$sparse_file")"

    # update sparse checkout file
    if [ "$HEADLESS" = true ]; then
        echo "/*" > "$sparse_file"
        for path in "${HEADLESS_EXCLUDES[@]}"; do
            echo "!/$path" >> "$sparse_file"
        done
    else
        echo "/*" > "$sparse_file"
    fi

    # checkout (overwrites local files)
    repo checkout --quiet 2> /dev/null
}

main() {
    parse_args "$@"

    print_bold "Installing to $REPO_LOCAL_DIR"
    if [ ! -d "$REPO_LOCAL_DIR" ]; then
        clone_repo
        backup_local_changes
    else
        fetch_remote
        backup_local_changes FETCH_HEAD
        delete_repo
        clone_repo
    fi
    
    sparse_checkout
    restore_local_changes

    print_local_changes
    echo
    print_bold "Bootstrap complete"
    local sparse_info
    sparse_info="$(repo status | sed -n 's/.*sparse checkout with \(.*\)\./\1/p')"
    if [ "$HEADLESS" = true ]; then
        sparse_info="$sparse_info (headless)"
    fi
    echo -e " $FINISH_ICON $sparse_info"
    echo -e " $FINISH_ICON Last commit $(repo log -1 --format=%cr)\e[2m - $(repo log -1 --format=%s)\e[0m"
}

cd "$HOME"
main "$@"
